// Fire, smoke and explosion volumes (src/fx_plumes.rs): a few analytic descriptors per burning
// wreck, fireball or shell burst, ray-marched per native pixel inside each one's bounding box and
// composited over the shaded frame with the same fog chain the surfaces take (`fog_to`), at any
// distance (the froxel grid ends at 320 m; these do not). A flame is a soot-laden emitting gas:
// absorption and Planck emission at a noisy temperature field (Kirchhoff); smoke is an absorbing,
// scattering medium lit by the key beam through its own optical depth, the sky, and the flame
// below it. Named approximations: the self-shadow toward the Sun and the sky is a two-step march
// of the smooth envelope (no noise); the plume casts no shadow on the scene; the flame's light on
// its smoke is one point source at the flame's centroid; the fog in front of the plume is taken
// at the plume's transmittance-weighted depth.
@group(2) @binding(0) var<storage, read> plumes: array<Plume>;
@group(2) @binding(1) var noise_tex: texture_3d<f32>;
@group(2) @binding(2) var noise_samp: sampler;

struct Plume {
    a: vec4<f32>,  // base xyz, kind
    b: vec4<f32>,  // column top offset from base xyz (wind bend included), base radius m
    c: vec4<f32>,  // flame strength 0..1.5, smoke extinction at the base /m, age s, seed
    d: vec4<f32>,  // flame height m, top radius m, smoke albedo, march steps
    e: vec4<f32>,  // bounds min xyz, flame light (renderer W/sr)
    f: vec4<f32>,  // bounds max xyz, snow share (bursts) / soot colour warmth
    r0: vec4<f32>, // flame roots: offset from base xyz, root radius m (0 = none)
    r1: vec4<f32>,
    r2: vec4<f32>,
};
const KIND_WRECK: u32 = 0u;
const KIND_FIREBALL: u32 = 1u;
const KIND_BURST: u32 = 2u;

struct VsOut {
    @builtin(position) position: vec4<f32>,
    @location(0) @interpolate(flat) index: u32,
};

// The bounding box's back faces (front faces culled at the pipeline), so the eye inside a plume
// still draws it.
@vertex
fn vs(@builtin(vertex_index) vertex: u32, @builtin(instance_index) instance: u32) -> VsOut {
    var corners = array<u32, 36>(0u,2u,1u, 1u,2u,3u, 4u,5u,6u, 5u,7u,6u, 0u,1u,4u, 1u,5u,4u,
        2u,6u,3u, 3u,6u,7u, 0u,4u,2u, 2u,4u,6u, 1u,3u,5u, 3u,7u,5u);
    let c = corners[vertex];
    let p = plumes[instance];
    let lo = p.e.xyz;
    let hi = p.f.xyz;
    let world = vec3(select(lo.x, hi.x, (c & 1u) != 0u), select(lo.y, hi.y, (c & 2u) != 0u), select(lo.z, hi.z, (c & 4u) != 0u));
    var out: VsOut;
    var clip = fr.view_proj * vec4(world - fr.cam_pos.xyz, 1.0);
    // A box reaching behind the eye: clamp onto the near side so the fragment still runs (the
    // ray, not the rasterized face, decides what is inside).
    if (clip.w < 0.02) { clip = vec4(clip.xy, 0.0, 0.02); }
    out.position = vec4(clip.xy, min(clip.z, clip.w * 0.999), clip.w);
    out.index = instance;
    return out;
}

fn plume_noise(q: vec3<f32>) -> f32 { return textureSampleLevel(noise_tex, noise_samp, q, 0.0).r; }
// Three octaves, each rotated off the lattice, 0..1 around 0.5.
fn plume_fbm(q: vec3<f32>) -> f32 {
    let a = plume_noise(q);
    let b = plume_noise(vec3(q.z, q.x, q.y) * 2.03 + vec3(0.31, 0.17, 0.53));
    let c = plume_noise(vec3(q.y, q.z, q.x) * 4.11 + vec3(0.71, 0.43, 0.29));
    return a * 0.55 + b * 0.30 + c * 0.15;
}

// Planck: the flame's soot radiance at temperature `kelvin`, renderer units (FX_PLANCK_* are
// generated by src/fx_plumes.rs from incandescence::planck_chroma and the photopic weight of the
// Planck spectrum, relative to 1500 K, times FX_FLAME_RADIANCE_1500K).
fn planck_radiance(kelvin: f32) -> vec3<f32> {
    let x = clamp((kelvin - FX_PLANCK_T0) / FX_PLANCK_DT, 0.0, f32(FX_PLANCK_N - 1u) - 0.001);
    let i = u32(floor(x));
    let f = x - f32(i);
    return mix(FX_PLANCK[i], FX_PLANCK[i + 1u], f) * FX_FLAME_RADIANCE_1500K;
}

struct Sample { sigma_t: f32, sigma_s: f32, emit: vec3<f32> };

// The column's centreline height share s (0 base .. 1 top) of world point p and its centre.
fn column_s(p: Plume, w: vec3<f32>) -> f32 {
    return clamp((w.y - p.a.y) / max(p.b.y, 0.5), 0.0, 1.0);
}
fn column_centre(p: Plume, s: f32) -> vec3<f32> {
    let lean = pow(s, 1.6);
    return p.a.xyz + vec3(p.b.x * lean, p.b.y * s, p.b.z * lean);
}
fn column_radius(p: Plume, s: f32) -> f32 {
    return mix(p.b.w, p.d.y, pow(s, 0.75));
}

// The smooth envelope alone (self-shadow marches): extinction /m.
fn wreck_envelope(p: Plume, w: vec3<f32>) -> f32 {
    let s = column_s(p, w);
    if (w.y < p.a.y - 0.5 || w.y > p.a.y + p.b.y) { return 0.0; }
    let r = column_radius(p, s);
    let d = length((w - column_centre(p, s)).xz);
    let dilution = pow(p.b.w / r, 1.3);
    let fade_top = 1.0 - smoothstep(0.75, 1.0, s);
    return p.c.y * dilution * fade_top * (1.0 - smoothstep(0.35 * r, r, d));
}

fn flame_temperature(p: Plume, w: vec3<f32>, t: f32) -> f32 {
    let strength = p.c.x;
    if (strength <= 0.01) { return 0.0; }
    let hf = p.d.x;
    var best = 0.0;
    var roots = array<vec4<f32>, 3>(p.r0, p.r1, p.r2);
    for (var k = 0u; k < 3u; k += 1u) {
        let root = roots[k];
        if (root.w <= 0.0) { continue; }
        let o = p.a.xyz + root.xyz;
        let h = (w.y - o.y) / hf;
        if (h < -0.05 || h > 1.3) { continue; }
        // A broad burning mass with licks: rising turbulence (the noise field climbs at about
        // 2.5 m/s) warps the body sideways more the higher it goes; the wind leans it a little.
        let q = vec3(w.x * 0.8, w.y * 0.6 - t * 2.4, w.z * 0.8) + vec3(f32(k) * 3.7, 0.0, p.c.w * 0.013);
        let n = plume_fbm(q * 0.5);
        let warp = vec2(plume_noise(q * 0.9 + vec3(0.3, 0.0, 0.0)), plume_noise(q * 0.9 + vec3(0.0, 0.0, 0.6))) - vec2(0.5);
        let n2 = plume_noise(vec3(w.x, w.y - t * 4.0, w.z) * 1.4 + vec3(p.c.w * 0.007));
        let lean = vec2(p.b.x, p.b.z) / max(p.b.y, 1.0) * hf * h * h * 0.25;
        let width = root.w * 1.5;
        let off = (w.xz - o.xz - lean - warp * width * (0.3 + 1.1 * clamp(h, 0.0, 1.0))) / width;
        let radius = (1.0 - 0.55 * clamp(h, 0.0, 1.0)) * (0.7 + 0.6 * n);
        let d = length(off) / max(radius, 0.05);
        let body = (1.0 - smoothstep(0.45, 1.0, d)) * (1.0 - smoothstep(0.45 + 0.5 * n2, 1.2, h));
        best = max(best, body * (0.7 + 0.5 * n2));
    }
    // Soot-laden flame: about 1000 K at the ragged edges, 1450 K in the body, hotter with strength.
    return select(0.0, 850.0 + best * (520.0 + 120.0 * min(strength, 1.5)), best > 0.04);
}

fn flame_only(p: Plume, w: vec3<f32>, t: f32) -> Sample {
    var out = Sample(0.0, 0.0, vec3(0.0));
    if (w.y > p.a.y + p.d.x * 1.4 + 1.0) { return out; }
    let kelvin = flame_temperature(p, w, t);
    if (kelvin > 0.0) {
        let k = 1.4 * smoothstep(850.0, 1100.0, kelvin);
        out.sigma_t = k;
        out.emit = k * planck_radiance(kelvin);
    }
    return out;
}

fn wreck_sample(p: Plume, w: vec3<f32>, t: f32) -> Sample {
    var out = Sample(0.0, 0.0, vec3(0.0));
    let s = column_s(p, w);
    if (w.y >= p.a.y - 0.5 && w.y <= p.a.y + p.b.y && p.c.y > 0.0) {
        let r = column_radius(p, s);
        let c = column_centre(p, s);
        let rel = w - c;
        // Empty space round the column (most of a leaning column's box): no noise taken.
        if (dot(rel.xz, rel.xz) > r * r * 2.3) { return flame_only(p, w, t); }
        // The smoke rises at a speed that slows with height (the plume's buoyancy spent) and
        // rolls as it goes: noise coordinates in the column's frame, advected upward.
        let rise = t * (3.5 - 2.0 * s);
        let q = vec3(rel.x / max(r, 0.5) * 0.9, (w.y - p.a.y - rise) / max(r * 1.6, 1.0), rel.z / max(r, 0.5) * 0.9)
            + vec3(p.c.w * 0.0011, 0.0, p.c.w * 0.0007);
        let n = plume_fbm(q * 0.6);
        let d = length(rel.xz) / r + (0.5 - n) * 0.9;
        // Entrainment widens the column and dilutes its soot; the slowing rise keeps it thick
        // (concentration about (r0 / r)^1.3 rather than the still-air (r0 / r)^2).
        let dilution = pow(p.b.w / r, 1.3);
        let fade_top = 1.0 - smoothstep(0.7, 1.0, s + (n - 0.5) * 0.3);
        // The soot leaves the flame tips: no smoke inside the lower flame body.
        let birth = smoothstep(0.0, 0.9, (w.y - p.a.y) / max(p.d.x * 0.6 + 0.3, 0.3));
        let density = p.c.y * dilution * fade_top * birth * (1.0 - smoothstep(0.25, 1.0, d)) * (0.35 + 1.3 * n);
        out.sigma_t = max(density, 0.0);
        out.sigma_s = out.sigma_t * p.d.z;
    }
    let kelvin = select(0.0, flame_temperature(p, w, t), w.y <= p.a.y + p.d.x * 1.4 + 1.0);
    if (kelvin > 0.0) {
        // Luminous soot flame: absorption about 1.4 /m, emitting Planck radiance (Kirchhoff).
        let k = 1.4 * smoothstep(850.0, 1100.0, kelvin);
        out.sigma_t += k;
        out.emit += k * planck_radiance(kelvin);
    }
    return out;
}

// A detonation's fireball (KIND_FIREBALL): `c.z` its age, `b.w` its final radius, `c.x` its heat.
fn fireball_sample(p: Plume, w: vec3<f32>, t: f32) -> Sample {
    var out = Sample(0.0, 0.0, vec3(0.0));
    let age = p.c.z;
    let rmax = p.b.w;
    // Expansion (fast, to about 90 % in 0.35 s per 10 m), then the hot cloud rises and spreads.
    let grow = 1.0 - exp(-age / (0.035 * rmax + 0.05));
    let rise = min(age, 12.0) * (1.8 + 0.12 * rmax) - 0.5 * 0.05 * age * age;
    let radius = rmax * (0.25 + 0.75 * grow) * (1.0 + 0.06 * age);
    let centre = p.a.xyz + vec3(p.b.x * age * 0.25, rise + radius * 0.4, p.b.z * age * 0.25);
    let rel = w - centre;
    if (dot(rel, rel) > radius * radius * 3.4 && (p.d.y <= 0.0 || w.y > centre.y)) { return out; }
    let q = rel / radius * 1.3 + vec3(0.0, -age * 0.35, 0.0) + vec3(p.c.w * 0.0013);
    let n = plume_fbm(q * 0.7);
    // Rolled toroidal billow: denser round the rim once it has risen.
    let torus = smoothstep(1.5, 4.0, age) * 0.35;
    let ring = abs(length(rel.xz) / radius - 0.55);
    let d = length(rel) / radius + (0.5 - n) * 1.1 + torus * (0.4 - ring);
    let body = 1.0 - smoothstep(0.35, 1.0, d);
    // Fades over its life (the soot drifts and thins).
    let life = 1.0 - smoothstep(p.d.x * 0.5, p.d.x, age);
    let sigma = p.c.y * body * life * (0.5 + n) * (rmax * rmax) / (radius * radius) * 0.7;
    out.sigma_t = sigma;
    out.sigma_s = sigma * p.d.z;
    // Burning: the propellant's and fillers' sooty flame (about 1650 K at the core) for the first
    // fraction of a second, cooling from the outside in, a dull glow lingering in the core.
    let heat = p.c.x * (exp(-age / (0.10 + 0.02 * rmax)) + 0.12 * exp(-age / (0.6 + 0.08 * rmax)))
        * (1.0 - smoothstep(0.15, 0.9, d)) * (0.6 + 0.7 * n);
    let kelvin = 900.0 + 760.0 * min(heat, 1.0);
    if (heat > 0.02 && kelvin > 950.0) {
        let k = 2.5 * smoothstep(950.0, 1200.0, kelvin);
        out.sigma_t += k;
        out.emit += k * planck_radiance(kelvin);
    }
    // Stem: a cook-off's thin column of smoke back down to the hull while the cloud rises.
    if (p.d.y > 0.0) {
        let s = clamp((w.y - p.a.y) / max(centre.y - p.a.y, 0.5), 0.0, 1.0);
        let axis = mix(p.a.xyz, centre, s);
        let rs = p.d.y * (0.6 + 0.4 * s) * (1.0 + 0.04 * age);
        let ds = length((w - axis).xz) / rs + (0.5 - n) * 0.7;
        let stem = (1.0 - smoothstep(0.3, 1.0, ds)) * smoothstep(0.0, 0.15, s) * (1.0 - smoothstep(0.85, 1.0, s)) * life;
        out.sigma_t += p.c.y * 0.5 * stem;
        out.sigma_s += p.c.y * 0.5 * stem * p.d.z;
    }
    return out;
}

// A shell's burst on the ground (KIND_BURST): the flash, then the thrown snow and earth (an
// upward fountain over a squat base cloud) drifting with the wind, settling and thinning.
fn burst_sample(p: Plume, w: vec3<f32>, t: f32) -> Sample {
    var out = Sample(0.0, 0.0, vec3(0.0));
    let age = p.c.z;
    let r = p.b.w;
    let rel0 = w - p.a.xyz - vec3(p.b.x, 0.0, p.b.z) * age * 0.3;
    let grow = 1.0 - exp(-age / 0.12);
    // The fountain: a cone of thrown material rising to about 2.5 radii, falling back after 1 s.
    let hcol = r * 4.2 * grow * (1.0 - 0.3 * smoothstep(1.2, 4.0, age));
    let s = clamp(rel0.y / max(hcol, 0.3), 0.0, 1.2);
    let rcol = r * (0.25 + 0.75 * s) * (0.4 + 0.6 * grow) * (1.0 + 0.15 * age);
    let rb = r * (0.5 + 0.9 * grow) * (1.0 + 0.2 * age);
    if (length(rel0.xz) > max(rb, r * (1.0 + 0.15 * age)) * 1.7 || rel0.y > hcol * 1.3 + rb) { return out; }
    let q = rel0 / r * 1.4 + vec3(0.0, age * 0.2, 0.0) + vec3(p.c.w * 0.0017);
    let n = plume_fbm(q * 0.8);
    let dc = length(rel0.xz) / rcol + (0.5 - n) * 1.0;
    let column = (1.0 - smoothstep(0.3, 1.0, dc)) * (1.0 - smoothstep(0.8, 1.15, s)) * step(-0.2, rel0.y);
    // The base surge: a low wide cloud.
    let db = length(vec3(rel0.x, rel0.y * 2.2, rel0.z)) / rb + (0.5 - n) * 0.8;
    let base = 1.0 - smoothstep(0.35, 1.0, db);
    let life = 1.0 - smoothstep(p.d.x * 0.4, p.d.x, age);
    let sigma = p.c.y * max(column * (1.0 - smoothstep(2.5, 6.0, age)), base * 0.7) * life * (0.4 + 1.1 * n);
    out.sigma_t = sigma;
    // The thrown earth and the shell's soot are dark at the core; the snow it lifts whitens the
    // edges and the settling cloud.
    let edge = smoothstep(0.35, 0.95, min(dc, db)) + smoothstep(1.0, 4.0, age) * 0.5;
    out.sigma_s = sigma * mix(0.07, p.d.z, clamp(edge, 0.0, 1.0));
    let heat = p.c.x * exp(-age / 0.07) * (1.0 - smoothstep(0.1, 0.8, length(rel0) / (r * 0.8)));
    if (heat > 0.03) {
        let kelvin = 1100.0 + 1200.0 * heat;
        let k = 3.0 * heat;
        out.sigma_t += k;
        out.emit += k * planck_radiance(kelvin);
    }
    return out;
}

fn plume_sample(p: Plume, w: vec3<f32>, t: f32) -> Sample {
    let kind = u32(p.a.w);
    if (kind == KIND_FIREBALL) { return fireball_sample(p, w, t); }
    if (kind == KIND_BURST) { return burst_sample(p, w, t); }
    return wreck_sample(p, w, t);
}

// The smooth envelope of a fireball or burst for its self-shadow: its sphere or column, no noise.
fn fireball_envelope(p: Plume, w: vec3<f32>) -> f32 {
    let age = p.c.z;
    let r = select(p.b.w * (0.6 + 0.25 * age), p.b.w * (1.0 + 0.06 * age), u32(p.a.w) == KIND_FIREBALL);
    let rise = select(r * 0.8, min(age, 12.0) * (1.8 + 0.12 * p.b.w) + r * 0.4, u32(p.a.w) == KIND_FIREBALL);
    let c = p.a.xyz + vec3(0.0, rise, 0.0);
    return p.c.y * 0.5 * (1.0 - smoothstep(0.5, 1.0, length(w - c) / r));
}

// Optical depth toward `dir` over `reach` metres through the smooth envelope (two steps).
fn plume_shadow(p: Plume, w: vec3<f32>, dir: vec3<f32>, reach: f32, t: f32) -> f32 {
    let kind = u32(p.a.w);
    var tau = 0.0;
    for (var i = 0u; i < 2u; i += 1u) {
        let x = w + dir * (reach * (f32(i) + 0.5) * 0.5);
        if (kind == KIND_WRECK) { tau += wreck_envelope(p, x); } else { tau += fireball_envelope(p, x); }
    }
    return tau * reach * 0.5;
}

fn ray_box(o: vec3<f32>, d: vec3<f32>, lo: vec3<f32>, hi: vec3<f32>) -> vec2<f32> {
    let inv = 1.0 / select(d, vec3(1.0e-6), abs(d) < vec3(1.0e-6));
    let t0 = (lo - o) * inv;
    let t1 = (hi - o) * inv;
    let tmin = min(t0, t1);
    let tmax = max(t0, t1);
    return vec2(max(max(tmin.x, tmin.y), tmin.z), min(min(tmax.x, tmax.y), tmax.z));
}

@fragment
fn fs(in: VsOut) -> @location(0) vec4<f32> {
    let p = plumes[in.index];
    let dims = vec2<i32>(textureDimensions(depth_tex));
    let pixel = vec2<i32>(in.position.xy);
    if (any(pixel < vec2(0)) || any(pixel >= dims)) { discard; }
    let uv = (vec2<f32>(pixel) + vec2(0.5)) * fr.res.zw;
    let ray = rm_ray(uv);
    let eye = fr.cam_pos.xyz;
    let depth = textureLoad(depth_tex, pixel, 0);
    let scene_m = select(length(rm_relative_from_depth(uv, depth)), 1.0e9, depth >= 1.0);
    let span = ray_box(eye, ray, p.e.xyz, p.f.xyz);
    let t0 = max(span.x, 0.0);
    let t1 = min(span.y, scene_m);
    if (t1 <= t0) { discard; }
    let t = fr.cam_pos.w;
    let steps = u32(clamp(p.d.w, 8.0, 64.0));
    let dt = (t1 - t0) / f32(steps);
    // Blue-noise-free per-pixel jitter (the crush's dither then hides the banding).
    let jitter = rm_hash01(u32(pixel.x) * 7919u + u32(pixel.y) * 104729u + u32(fr.vol.w) * 2654435761u);
    let sun_on = fr.sun_radiance.w > 0.5;
    let mu = dot(ray, fr.sun_dir.xyz);
    let sky_down = (fr.sky_zenith.rgb + fr.sky_horizon.rgb) * 0.5;
    let sky_up = fr.sky_ground.rgb;
    let flame_pos = p.a.xyz + vec3(0.0, p.d.x * 0.45, 0.0);
    let flame_i = p.e.w;
    var radiance = vec3(0.0);
    var trans = 1.0;
    var depth_sum = 0.0;
    var weight_sum = 0.0;
    let reach = max(p.b.w, 1.5) * 1.5;
    for (var i = 0u; i < steps; i += 1u) {
        let tt = t0 + (f32(i) + jitter) * dt;
        let w = eye + ray * tt;
        let s = plume_sample(p, w, t);
        if (s.sigma_t <= 1.0e-4) { continue; }
        var source = s.emit;
        if (s.sigma_s > 0.0) {
            var light = vec3(0.0);
            if (sun_on) {
                let tau_sun = plume_shadow(p, w, fr.sun_dir.xyz, reach, t);
                light += fr.sun_radiance.rgb * rm_phase_dense(mu, 0.35, s.sigma_t) * exp(-tau_sun) * rm_cloud_shadow(w);
            }
            let tau_up = plume_shadow(p, w, vec3(0.0, 1.0, 0.0), reach, t);
            // The sky above through the plume's own depth, the snow's upwelling light below.
            light += sky_down * exp(-tau_up) * 0.9 + sky_up * 0.5;
            if (flame_i > 0.0) {
                let to_flame = flame_pos - w;
                let d2 = max(dot(to_flame, to_flame), 0.25);
                light += FX_FLAME_TINT * flame_i / d2 * exp(-sqrt(d2) * s.sigma_t * 0.25) / (4.0 * RM_PI);
            }
            source += s.sigma_s * light;
        }
        let step_t = exp(-s.sigma_t * dt);
        let absorbed = trans * (1.0 - step_t);
        radiance += trans * source * (1.0 - step_t) / s.sigma_t;
        depth_sum += absorbed * tt;
        weight_sum += absorbed;
        trans *= step_t;
        if (trans < 0.004) { break; }
    }
    if (weight_sum <= 1.0e-5) { discard; }
    let alpha = 1.0 - trans;
    // The air between the eye and the plume: its in-scatter stays in front, its transmittance
    // dims the plume's own light, and the plume hides what lies behind it (premultiplied).
    let fog = fog_to(uv, ray, depth_sum / weight_sum, true);
    return vec4(fog.radiance * alpha + fog.transmittance * radiance, alpha);
}
