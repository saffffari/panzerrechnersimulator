// The spring meadow on the raymarch backend (src/meadow.rs, src/renderer_meadow.rs): every grass
// blade and wild flower is real triangle geometry generated here from world-fixed counter-seeded
// roots; nothing is a card, an alpha cutout or a screen-space pattern. One instance is one 2 m
// world tile; the vertex index picks the blade (or flower) of the tile and its vertex. The MD_*
// constants are generated by meadow::wgsl_constants and prepended. G-buffer layout as
// rm_gbuffer.wgsl, kind 5 (a living leaf, rm_shade.wgsl): g0 the blade's diffuse reflectance rho
// + kind, g1 normal + roughness (the cuticle), g2 the blade's diffuse transmittance tau + the leaf
// area above this point (the canopy's turbid-medium depth). rho and tau are PROSPECT-D's at the
// renderer's wavelengths (leaf_optics.rs) for three leaf states.
struct View {
    vp: mat4x4<f32>,
    origin: vec4<f32>, // xyz subtracted before vp (the camera's eye; 0 for the sun/sky views); w time (s)
    eye: vec4<f32>,    // LOD eye xyz (always the camera); w the camera's pixel angle (rad per pixel)
    lod: vec4<f32>,    // x this view's texel (m; 0 for the camera), y this view's radius (m), z 1 camera, w unused
    wind: vec4<f32>,   // xy wind window origin (m), z cell (m), w cells per side
    map: vec4<f32>,    // x height spacing (m), y height res, z cover half extent (m), w track table side (pages)
    air: vec4<f32>,    // xy mean wind (m/s), z track atlas pages per side, w unused
};
@group(0) @binding(0) var<uniform> mv: View;
@group(0) @binding(1) var heights: texture_2d<f32>;
@group(0) @binding(2) var cover_tex: texture_2d<f32>;
@group(0) @binding(3) var cover_samp: sampler;
@group(0) @binding(4) var wind_tex: texture_2d<f32>;
@group(0) @binding(5) var track_table: texture_2d<u32>;
@group(0) @binding(6) var track_atlas: texture_2d<u32>;

const MD_TAU: f32 = 6.2831853;

fn md_hash(x0: u32) -> u32 {
    var x = x0;
    x = x ^ (x >> 16u);
    x = x * 0x7feb352du;
    x = x ^ (x >> 15u);
    x = x * 0x846ca68bu;
    x = x ^ (x >> 16u);
    return x;
}
fn md_hash2(a: i32, b: i32, salt: u32) -> u32 {
    return md_hash((bitcast<u32>(a) * 0x8da6b343u) ^ (bitcast<u32>(b) * 0xd8163841u) ^ (salt * 0xcb1ab31fu));
}
fn md_unit(h: u32) -> f32 { return f32(h >> 8u) / 16777216.0; }
fn md_smooth01(t: f32) -> f32 { return t * t * (3.0 - 2.0 * t); }
fn md_noise(x: f32, z: f32, salt: u32) -> f32 {
    let fx = floor(x);
    let fz = floor(z);
    let ix = i32(fx);
    let iz = i32(fz);
    let tx = md_smooth01(x - fx);
    let tz = md_smooth01(z - fz);
    let v00 = md_unit(md_hash2(ix, iz, salt));
    let v10 = md_unit(md_hash2(ix + 1, iz, salt));
    let v01 = md_unit(md_hash2(ix, iz + 1, salt));
    let v11 = md_unit(md_hash2(ix + 1, iz + 1, salt));
    let a = v00 + (v10 - v00) * tx;
    let b = v01 + (v11 - v01) * tx;
    return a + (b - a) * tz;
}
fn md_r2(seed: u32, k: u32) -> vec2<f32> {
    let base = vec2(md_unit(seed), md_unit(md_hash(seed ^ 0x9e3779b9u)));
    return fract(base + vec2(f32(k) * MD_R2_A1, f32(k) * MD_R2_A2));
}

// The drawn terrain grid's surface (terrain.rs Heightfield::grade_at): each cell split along its
// (i+1, j)-(i, j+1) diagonal.
fn md_ground(p: vec2<f32>) -> f32 {
    let res = i32(mv.map.y);
    let half = (mv.map.y - 1.0) * 0.5;
    let gx = p.x / mv.map.x + half;
    let gz = p.y / mv.map.x + half;
    let last = f32(res - 2);
    let x0 = clamp(floor(gx), 0.0, last);
    let z0 = clamp(floor(gz), 0.0, last);
    let tx = clamp(gx - x0, 0.0, 1.0);
    let tz = clamp(gz - z0, 0.0, 1.0);
    let i = i32(x0);
    let j = i32(z0);
    let h00 = textureLoad(heights, vec2<i32>(i, j), 0).r;
    let h10 = textureLoad(heights, vec2<i32>(i + 1, j), 0).r;
    let h01 = textureLoad(heights, vec2<i32>(i, j + 1), 0).r;
    let h11 = textureLoad(heights, vec2<i32>(i + 1, j + 1), 0).r;
    if (tx + tz <= 1.0) { return h00 + (h10 - h00) * tx + (h01 - h00) * tz; }
    return h11 + (h01 - h11) * (1.0 - tx) + (h10 - h11) * (1.0 - tz);
}

// Grass presence (x) and lushness (y).
fn md_cover(p: vec2<f32>) -> vec2<f32> {
    let half = mv.map.z;
    if (abs(p.x) >= half || abs(p.y) >= half) { return vec2(0.0); }
    return textureSampleLevel(cover_tex, cover_samp, p / (2.0 * half) + vec2(0.5), 0.0).rg;
}

// The wind grid's bend of a reference blade's tip (m, world xz), bilinear between cell centres.
fn md_wind(p: vec2<f32>) -> vec2<f32> {
    let n = i32(mv.wind.w);
    let g = (p - mv.wind.xy) / mv.wind.z - vec2(0.5);
    let f = floor(g);
    let t = g - f;
    let i = vec2<i32>(f);
    let c00 = textureLoad(wind_tex, clamp(i, vec2(0), vec2(n - 1)), 0).rg;
    let c10 = textureLoad(wind_tex, clamp(i + vec2(1, 0), vec2(0), vec2(n - 1)), 0).rg;
    let c01 = textureLoad(wind_tex, clamp(i + vec2(0, 1), vec2(0), vec2(n - 1)), 0).rg;
    let c11 = textureLoad(wind_tex, clamp(i + vec2(1, 1), vec2(0), vec2(n - 1)), 0).rg;
    return mix(mix(c00, c10, t.x), mix(c01, c11, t.x), t.y);
}

// The grass contact memory (grass_filament.rs TrackMemory): the heading code (0..63) of the
// tread that laid this 25 cm cell flat, 255 where no tread has run.
fn md_track(p: vec2<f32>) -> u32 {
    let cell = vec2<i32>(floor(p / MD_TRACK_CELL));
    let page = vec2<i32>(floor(vec2<f32>(cell) / f32(MD_TRACK_PAGE)));
    let side = i32(mv.map.w);
    let index = page + vec2(side / 2);
    if (any(index < vec2(0)) || any(index >= vec2(side))) { return 255u; }
    let entry = textureLoad(track_table, index, 0).r;
    if (entry == 0u) { return 255u; }
    let slot = entry - 1u;
    let pages = u32(mv.air.z);
    let local = cell - page * MD_TRACK_PAGE;
    let atlas = vec2<i32>(i32(slot % pages) * MD_TRACK_PAGE, i32(slot / pages) * MD_TRACK_PAGE) + local;
    return textureLoad(track_atlas, atlas, 0).r;
}

fn md_bed(s: u32, x: f32, z: f32) -> f32 {
    let scale = MD_SP_SCALE[s];
    let salt = MD_SP_SALT[s];
    let n = md_noise(x / scale, z / scale, salt) * 0.7 + md_noise(x * 3.0 / scale, z * 3.0 / scale, salt ^ 0x55u) * 0.3;
    return smoothstep(MD_SP_LO[s], MD_SP_HI[s], n);
}

struct VsOut {
    @builtin(position) clip: vec4<f32>,
    @location(0) normal: vec3<f32>,
    @location(1) relative: vec3<f32>,
    @location(2) albedo: vec3<f32>,
    @location(3) tau: vec3<f32>,
    @location(4) lai_above: f32,
};

fn md_culled() -> VsOut {
    var out: VsOut;
    out.clip = vec4(2.0, 2.0, 2.0, 1.0);
    out.normal = vec3(0.0, 1.0, 0.0);
    out.relative = vec3(0.0);
    out.albedo = vec3(0.0);
    out.tau = vec3(0.0);
    out.lai_above = 0.0;
    return out;
}

fn md_emit(world: vec3<f32>, normal: vec3<f32>, albedo: vec3<f32>, tau: vec3<f32>, lai_above: f32) -> VsOut {
    var out: VsOut;
    out.tau = tau;
    out.lai_above = lai_above;
    out.relative = world - mv.origin.xyz;
    out.clip = mv.vp * vec4(out.relative, 1.0);
    out.normal = normal;
    out.albedo = albedo;
    return out;
}

// The stand at a root: canopy height H (the tallest blades) and leaf area index (one-sided blade
// area per ground area: density x width x mean height, conserved by the LOD).
fn md_canopy(cv: vec2<f32>) -> vec2<f32> {
    let h = (MD_HEIGHT_MIN + MD_HEIGHT_SPAN * cv.y) * (0.55 + 0.45 * cv.x);
    return vec2(h, MD_NEAR_DENSITY * MD_BLADE_WIDTH * h * 0.81 * cv.x);
}
// Leaf area above a point at height y over the ground: a uniform vertical distribution.
fn md_lai_above(canopy: vec2<f32>, above_ground: f32) -> f32 {
    return canopy.y * clamp(1.0 - above_ground / max(canopy.x, 0.05), 0.0, 1.0);
}

// The widened width and the density of blades at distance d from the eye (meadow.rs
// blade_width / blade_density): blade area per ground area is conserved.
fn md_width(d: f32) -> f32 {
    let footprint = max(mv.eye.w * d, mv.lod.x);
    return max(MD_BLADE_WIDTH, MD_MIN_PIXELS * footprint);
}

// Point of a quadratic centreline and its tangent.
fn md_curve(a: vec3<f32>, b: vec3<f32>, c: vec3<f32>, t: f32) -> vec3<f32> {
    return (1.0 - t) * (1.0 - t) * a + 2.0 * t * (1.0 - t) * b + t * t * c;
}
fn md_curve_tangent(a: vec3<f32>, b: vec3<f32>, c: vec3<f32>, t: f32) -> vec3<f32> {
    return 2.0 * (1.0 - t) * (b - a) + 2.0 * t * (c - b);
}

// Which centreline sample (index along the blade) and which edge (-1, +1, 0 tip) vertex `v`
// of a ribbon with `segs` segments is: quads below, one tip triangle.
fn md_ribbon(v: u32, segs: u32) -> vec2<f32> {
    let tri = v / 3u;
    let corner = v % 3u;
    let seg = tri / 2u;
    if (seg + 1u >= segs && tri >= 2u * (segs - 1u)) {
        let s = segs - 1u;
        if (corner == 0u) { return vec2(f32(s), -1.0); }
        if (corner == 1u) { return vec2(f32(s), 1.0); }
        return vec2(f32(segs), 0.0);
    }
    if (tri % 2u == 0u) {
        if (corner == 0u) { return vec2(f32(seg), -1.0); }
        if (corner == 1u) { return vec2(f32(seg), 1.0); }
        return vec2(f32(seg + 1u), -1.0);
    }
    if (corner == 0u) { return vec2(f32(seg), 1.0); }
    if (corner == 1u) { return vec2(f32(seg + 1u), 1.0); }
    return vec2(f32(seg + 1u), -1.0);
}

// Distance from the LOD eye, the draw-range shrink of this view, and the culling radius.
fn md_range(root: vec3<f32>, radius: f32, fade_start: f32) -> vec2<f32> {
    let d = distance(root, mv.eye.xyz);
    let fade = 1.0 - smoothstep(fade_start, radius, d);
    return vec2(d, fade);
}

@vertex
fn vs_blade(@builtin(vertex_index) vi: u32, @location(0) tile: vec4<i32>) -> VsOut {
    let level = u32(tile.z);
    let segs = select(select(1u, 2u, level < 4u), 3u, level < 2u);
    let per_blade = (2u * segs - 1u) * 3u;
    let j = vi / per_blade;
    let v = vi % per_blade;
    // tile.w 1: an 8 m far tile with its own seeds, cross-faded with the 2 m near tiles over
    // the band below the near radius (meadow.rs FAR_TILE_M).
    let far = tile.w == 1;
    let tile_m = select(MD_TILE, MD_FAR_TILE, far);
    let seed = md_hash2(tile.x, tile.y, select(MD_SALT_TILE, MD_SALT_FAR, far));
    let root2 = (vec2(f32(tile.x), f32(tile.y)) + md_r2(seed, j)) * tile_m;
    let radius = select(mv.lod.y, MD_FAR_RADIUS, far);
    if (distance(root2, mv.eye.xz) > radius) { return md_culled(); }
    let cv = md_cover(root2);
    if (cv.x <= 0.004) { return md_culled(); }
    let ground = md_ground(root2);
    let root = vec3(root2.x, ground - 0.01, root2.y);
    let d = distance(root, mv.eye.xyz);
    var fade = 1.0 - smoothstep(radius * 0.85, radius, d);
    if (mv.lod.z > 0.5) {
        let band = smoothstep(MD_NEAR_RADIUS - MD_BAND, MD_NEAR_RADIUS, d);
        fade = select(1.0 - band, band * (1.0 - smoothstep(MD_NEAR_RADIUS, MD_FAR_RADIUS, d)), far);
    }
    let width = md_width(d);
    let count = MD_NEAR_DENSITY * MD_BLADE_WIDTH / width * tile_m * tile_m * cv.x;
    let grow = clamp(count - f32(j), 0.0, 1.0) * fade;
    if (grow <= 0.001) { return md_culled(); }

    let h = md_hash(seed ^ (j * 0x9e3779b1u));
    let r0 = md_unit(h);
    let r1 = md_unit(md_hash(h ^ 0x01u));
    let r2 = md_unit(md_hash(h ^ 0x02u));
    let r3 = md_unit(md_hash(h ^ 0x03u));
    let r4 = md_unit(md_hash(h ^ 0x04u));
    let r5 = md_unit(md_hash(h ^ 0x05u));
    let r6 = md_unit(md_hash(h ^ 0x06u));
    // 0.30-0.60 m by lushness; thin cover (the tan dry ground) carries shorter grass.
    let height = (MD_HEIGHT_MIN + MD_HEIGHT_SPAN * cv.y) * (0.62 + 0.38 * r0) * (0.55 + 0.45 * cv.x) * grow;
    let blade_w = width * (0.7 + 0.6 * r1);
    let azimuth = r2 * MD_TAU;
    let facing = vec3(cos(azimuth), 0.0, sin(azimuth));
    let lean = 0.10 + 0.50 * r3 * r3;

    // The wind grid's bend for this blade's height and stiffness, and the blade's own flutter at
    // its hashed natural frequency (named in the ledger).
    let bend = md_wind(root2) * (height / MD_WIND_REFERENCE_HEIGHT) * (0.75 + 0.5 * r4);
    let speed = length(mv.air.xy);
    let across = vec3(-facing.z, 0.0, facing.x);
    let flutter = across * (0.0035 * speed * height / MD_WIND_REFERENCE_HEIGHT)
        * sin(MD_TAU * (2.5 + 2.0 * r5) * mv.origin.w + r6 * MD_TAU);

    var tip = root + vec3(0.0, height * sqrt(1.0 - lean * lean), 0.0) + facing * (height * lean)
        + vec3(bend.x, 0.0, bend.y) + flutter;
    var rise = tip - root;
    rise.y = max(rise.y, 0.12 * height);
    tip = root + normalize(rise) * height;
    var mid = root + vec3(0.0, 0.55 * (tip.y - root.y), 0.0) + vec3(tip.x - root.x, 0.0, tip.z - root.z) * 0.22;

    // Laid flat by a tread, along its heading with some spread.
    let code = md_track(root2);
    if (code != 255u) {
        let a = f32(code) * MD_TAU / 64.0 + (r5 - 0.5) * 0.9;
        let lie = vec3(sin(a), 0.0, cos(a));
        tip = root + lie * (height * 0.93) + vec3(0.0, 0.03 + 0.06 * height, 0.0);
        mid = root + lie * (height * 0.40) + vec3(0.0, 0.03 + 0.05 * height, 0.0);
    }

    let pick = md_ribbon(v, segs);
    let t = pick.x / f32(segs);
    let centre = md_curve(root, mid, tip, t);
    var tangent = md_curve_tangent(root, mid, tip, t);
    let horizontal = vec3(tip.x - root.x, 0.0, tip.z - root.z);
    var side = across;
    if (length(horizontal) > 0.01 * height) { side = normalize(cross(vec3(0.0, 1.0, 0.0), horizontal)); }
    let half_w = 0.5 * blade_w * (1.0 - 0.8 * t);
    let world = centre + side * (pick.y * half_w);
    tangent = normalize(tangent);
    // A ribbon's shading normal, rounded across its width (the blade's keel).
    let face = normalize(cross(side, tangent));
    let normal = normalize(face + side * (0.35 * pick.y));

    // Albedo: display-equivalent linear greens from the earlier grass palette, in world-fixed
    // 9 m and 31 m patches; old tips paler, sheaths at the root paler (named in the ledger).
    let field = md_noise(root2.x / 31.0, root2.y / 31.0, 0x600du) * 0.75 + md_noise(root2.x / 9.0, root2.y / 9.0, 0x601du) * 0.25;
    // Leaf state: fresh and paler blades in world-fixed 9 m / 31 m patches, senescent straw on the
    // thin (tan) ground and toward some old tips; each blade's vigour scales its reflectance.
    let pale = smoothstep(0.30, 0.75, field) * 0.7;
    let dry = max(smoothstep(0.95, 0.60, cv.x) * 0.75, t * t * (0.05 + 0.35 * r6));
    var rho = mix(mix(MD_LEAF_RHO_FRESH, MD_LEAF_RHO_PALE, pale), MD_LEAF_RHO_DRY, dry) * (0.85 + 0.30 * r1);
    var tau = mix(mix(MD_LEAF_TAU_FRESH, MD_LEAF_TAU_PALE, pale), MD_LEAF_TAU_DRY, dry);
    let canopy = md_canopy(cv);
    return md_emit(world, normal, rho, tau, md_lai_above(canopy, world.y - root.y));
}

// A flower: a two-segment stem and a six-triangle head (centre colour to petal colour), 27
// vertices. Species clumps as meadow.rs flower_at; the head is widened to the pixel footprint
// with its slots thinned by the square of that widening, conserving coloured area.
@vertex
fn vs_flower(@builtin(vertex_index) vi: u32, @location(0) tile: vec4<i32>) -> VsOut {
    let k = vi / 27u;
    let v = vi % 27u;
    let seed = md_hash2(tile.x, tile.y, MD_SALT_FLOWER);
    let root2 = (vec2(f32(tile.x), f32(tile.y)) + md_r2(seed, k)) * MD_TILE;
    if (distance(root2, mv.eye.xz) > MD_FLOWER_RADIUS) { return md_culled(); }
    let cv = md_cover(root2);
    if (cv.x <= 0.004) { return md_culled(); }
    let h = md_hash(seed ^ (k * 0x9e3779b1u));
    let pick = md_unit(h) * MD_FLOWER_CAP;
    var cumulative = 0.0;
    var s = MD_SPECIES;
    for (var i = 0u; i < MD_SPECIES; i++) {
        cumulative += MD_SP_PEAK[i] * md_bed(i, root2.x, root2.y) * cv.x;
        if (pick < cumulative) { s = i; break; }
    }
    if (s == MD_SPECIES) { return md_culled(); }
    // Crushed under a tread.
    if (md_track(root2) != 255u) { return md_culled(); }
    let ground = md_ground(root2);
    let root = vec3(root2.x, ground - 0.01, root2.y);
    let range = md_range(root, MD_FLOWER_RADIUS, MD_FLOWER_RADIUS * 0.8);
    let footprint = max(mv.eye.w * range.x, mv.lod.x);
    let radius = MD_SP_RADIUS[s];
    let head = max(radius, 0.5 * MD_MIN_PIXELS * footprint);
    let widen = head / radius;
    if (md_unit(md_hash(h ^ 0x77u)) * widen * widen > 1.0) { return md_culled(); }
    let stem = (MD_SP_STEM0[s] + (MD_SP_STEM1[s] - MD_SP_STEM0[s]) * md_unit(md_hash(h ^ 0x51u))) * range.y;
    if (stem <= 0.01) { return md_culled(); }
    let r2 = md_unit(md_hash(h ^ 0x02u));
    let r3 = md_unit(md_hash(h ^ 0x03u));
    let r5 = md_unit(md_hash(h ^ 0x05u));
    let azimuth = r2 * MD_TAU;
    let facing = vec3(cos(azimuth), 0.0, sin(azimuth));
    let bend = md_wind(root2) * (stem / MD_WIND_REFERENCE_HEIGHT) * 0.7;
    let speed = length(mv.air.xy);
    let sway = facing * (0.004 * speed * stem / MD_WIND_REFERENCE_HEIGHT) * sin(MD_TAU * (1.8 + 1.2 * r5) * mv.origin.w + r3 * MD_TAU);
    var rise = vec3(0.0, stem, 0.0) + facing * (stem * 0.12 * r3) + vec3(bend.x, 0.0, bend.y) + sway;
    rise.y = max(rise.y, 0.2 * stem);
    let top = root + normalize(rise) * stem;
    let mid = root + vec3(0.0, 0.5 * (top.y - root.y), 0.0) + vec3(top.x - root.x, 0.0, top.z - root.z) * 0.2;
    if (v < 9u) {
        let sample = md_ribbon(v, 2u);
        let t = sample.x / 2.0;
        let c = md_curve(root, mid, top, t);
        let tangent = normalize(md_curve_tangent(root, mid, top, t));
        let side = normalize(cross(tangent, facing) + vec3(1e-4, 0.0, 0.0));
        let w = max(0.003, MD_MIN_PIXELS * footprint) * (1.0 - 0.5 * t);
        let normal = normalize(cross(side, tangent));
        let p = c + side * (sample.y * 0.5 * w);
        return md_emit(p, normal, MD_LEAF_RHO_FRESH, MD_LEAF_TAU_FRESH, md_lai_above(md_canopy(cv), p.y - root.y));
    }
    // The head: a fan of six triangles about its centre, tilted with the stem's last tangent.
    // Heads face up and out, tilted 30-55 degrees toward their own azimuth.
    let up = normalize(normalize(md_curve_tangent(root, mid, top, 1.0)) + facing * (0.6 + 0.8 * r5));
    let e1 = normalize(cross(up, facing + vec3(0.0, 0.0, 1e-4)));
    let e2 = cross(e1, up);
    let tri = (v - 9u) / 3u;
    let corner = (v - 9u) % 3u;
    let centre = top + up * (MD_SP_RISE[s] * widen);
    if (corner == 0u) {
        // Petals pass light too: tau = 0.4 rho (an estimate, not a petal measurement).
        return md_emit(centre, up, MD_SP_C[s], MD_SP_C[s] * 0.4, md_lai_above(md_canopy(cv), centre.y - root.y));
    }
    let a = (f32(tri) + select(0.0, 1.0, corner == 2u)) * MD_TAU / 6.0 + azimuth;
    let rim = top + (e1 * cos(a) + e2 * sin(a)) * head;
    let a0 = f32(tri) * MD_TAU / 6.0 + azimuth;
    let a1 = a0 + MD_TAU / 6.0;
    let n = normalize(cross(top + (e1 * cos(a1) + e2 * sin(a1)) * head - centre, top + (e1 * cos(a0) + e2 * sin(a0)) * head - centre));
    return md_emit(rim, select(n, -n, dot(n, up) < 0.0), MD_SP_P[s], MD_SP_P[s] * 0.4, md_lai_above(md_canopy(cv), rim.y - root.y));
}

// The far meadow's canopy slab (meadow.rs SLAB_*; shaded as kind 6 by rm_shade.wgsl): a shell at
// the canopy's top over the drawn ground, rising over the band where the blades fade, carrying
// the stand's leaf optics and leaf area index. tile.z 0: a 32 m tile of 8 x 8 quads, 1: 128 m of 16 x 16.
@vertex
fn vs_slab(@builtin(vertex_index) vi: u32, @location(0) tile: vec4<i32>) -> VsOut {
    let far = tile.z == 1;
    let tile_m = select(MD_SLAB_TILE, MD_SLAB_TILE_FAR, far);
    let q = select(8u, 16u, far);
    let quad = vi / 6u;
    let c = vi % 6u;
    var corner = array<vec2<u32>, 6>(vec2(0u, 0u), vec2(1u, 0u), vec2(0u, 1u), vec2(0u, 1u), vec2(1u, 0u), vec2(1u, 1u));
    let g = vec2(quad % q, quad / q) + corner[c];
    let p = vec2(f32(tile.x), f32(tile.y)) * tile_m + vec2<f32>(g) * (tile_m / f32(q));
    let cv = md_cover(p);
    let canopy = md_canopy(cv);
    let ground = md_ground(p);
    let d = distance(vec3(p.x, ground, p.y), mv.eye.xyz);
    let rise = smoothstep(MD_SLAB_START, MD_SLAB_FULL, d);
    let e = mv.map.x;
    let normal = normalize(vec3(md_ground(p - vec2(e, 0.0)) - md_ground(p + vec2(e, 0.0)), 2.0 * e,
        md_ground(p - vec2(0.0, e)) - md_ground(p + vec2(0.0, e))));
    let field = md_noise(p.x / 31.0, p.y / 31.0, 0x600du) * 0.75 + md_noise(p.x / 9.0, p.y / 9.0, 0x601du) * 0.25;
    let pale = smoothstep(0.30, 0.75, field) * 0.7;
    let dry = smoothstep(0.95, 0.60, cv.x) * 0.75 + 0.03;
    let rho = mix(mix(MD_LEAF_RHO_FRESH, MD_LEAF_RHO_PALE, pale), MD_LEAF_RHO_DRY, dry);
    let tau = mix(mix(MD_LEAF_TAU_FRESH, MD_LEAF_TAU_PALE, pale), MD_LEAF_TAU_DRY, dry);
    let world = vec3(p.x, ground + canopy.x * rise, p.y);
    return md_emit(world, normal, rho, tau, canopy.y * rise);
}

@fragment
fn fs_slab(in: VsOut) -> GOut {
    // Bare ground (roads, soil, water) and the foot of the band carry no canopy: the terrain shows.
    if (in.lai_above < 0.1) { discard; }
    var out: GOut;
    out.g0 = vec4(in.albedo, 6.0);
    out.g1 = vec4(normalize(in.normal), 1.0);
    out.g2 = vec4(in.tau, in.lai_above);
    return out;
}

struct GOut {
    @location(0) g0: vec4<f32>,
    @location(1) g1: vec4<f32>,
    @location(2) g2: vec4<f32>,
};

@fragment
fn fs_gbuffer(in: VsOut, @builtin(front_facing) front: bool) -> GOut {
    var n = normalize(in.normal);
    let view = normalize(-in.relative);
    if (dot(n, view) < 0.0) { n = -n; }
    var out: GOut;
    out.g0 = vec4(in.albedo, 5.0);
    out.g1 = vec4(n, MD_CUTICLE_ROUGHNESS);
    out.g2 = vec4(in.tau, in.lai_above);
    return out;
}
