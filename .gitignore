/target
/dist/
__pycache__/
*.py[cod]
.DS_Store
# Runtime binaries and authoring sources stay local; only the versioned campaign contracts are
# tracked so code cannot point at manifests that exist solely in one ignored checkout.
/assets/*
# Track portable editor-authored JSON while keeping every tank mesh/texture and preview private.
!/assets/tanks/
/assets/tanks/*
!/assets/tanks/tiger/
/assets/tanks/tiger/*
!/assets/tanks/tiger/dressing.v1.json
# This single CC0 character is intentionally source-controlled so a fresh checkout can reproduce
# the crew bake. Keep every sibling asset warehouse path ignored.
!/assets/flavor/
/assets/flavor/*
!/assets/flavor/Characters/
/assets/flavor/Characters/*
!/assets/flavor/Characters/german-ww2-soldier-cc0/
!/assets/flavor/Characters/german-ww2-soldier-cc0/**
# Track only the provenance/bake receipt for the local P08. Its source and runtime GLBs stay ignored
# until ownership permits redistribution.
!/assets/flavor/luger/
/assets/flavor/luger/*
!/assets/flavor/luger/SOURCE.md
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/VT323-Regular.ttf
!/assets/fonts/PressStart2P-Regular.ttf
!/assets/fonts/LICENSES.md
!/assets/fonts/OFL-1.1.txt
!/assets/worldgen/
/assets/worldgen/*
!/assets/worldgen/act1/
!/assets/worldgen/act2/
!/assets/worldgen/act3/
!/assets/worldgen/scene_blocks/
!/assets/worldgen/prefabs/
/assets/worldgen/act1/*
/assets/worldgen/act2/*
/assets/worldgen/act3/*
/assets/worldgen/scene_blocks/*
/assets/worldgen/prefabs/*
!/assets/worldgen/act1/manifest.v1.json
!/assets/worldgen/act2/manifest.v1.json
!/assets/worldgen/act3/manifest.v1.json
!/assets/worldgen/act1/manifest_edits.json
!/assets/worldgen/act2/manifest_edits.json
!/assets/worldgen/act3/manifest_edits.json
!/assets/worldgen/act1/level_design.v1.json
!/assets/worldgen/act2/level_design.v1.json
!/assets/worldgen/act3/level_design.v1.json
!/assets/worldgen/scene_blocks/*.json
!/assets/worldgen/prefabs/*.json
.directory
*.png
!/assets/flavor/Characters/german-ww2-soldier-cc0/source/LowpolySoldier_Texture.png
*.jpg
*.jpeg
*.mp4
/artifacts/visual-moodboard-2026-08-11/
# Generated review media, cue workbooks, dry WAV banks, and research captures are delivered outside
# source control. Their deterministic render/build scripts remain tracked.
/artifacts/audio/
# Selected Pizza Doggy OGGs and their local license receipt form an owner-private runtime layer.
# The tracked manifest/cooker live outside assets; no source or cooked proprietary audio enters Git.
/assets/sounds/pizza_private/
# Owner-private Pizza Doggy Blender yards contain the complete purchased model library and must
# never enter source control or a release payload. The reproducible builder/report policy is tracked.
/artifacts/pizza-doggy-blender-yard-*/
Cargo.lock.bak
/.claude

# This exact CC-BY-4.0 Soviet character family is intentionally reviewable: preserve the operator-
# downloaded GLB byte-for-byte alongside attribution, hashes, rigged authoring output, and static
# runtime pose receipts. Do not broaden this exception to sibling flavor/character warehouses.
!/assets/flavor/Characters/soviet-ww2-soldier-cc-by-4/
!/assets/flavor/Characters/soviet-ww2-soldier-cc-by-4/**
