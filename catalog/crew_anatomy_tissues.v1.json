{
 "schema": "kessel.crew-anatomy-tissues",
 "version": 1,
 "purpose": "One row per label of the crew anatomy voxel volume (tools/anatomy/build_anatomy.py; docs/CREW_ANATOMY_VOXELS.md). Label ids are permanent: append new labels, never renumber.",
 "units": {
  "density_kg_m3": "kg/m3",
  "blood_volume_fraction": "volume of blood per volume of tissue in vivo (0..1)",
  "tear_energy_density_j_m3": "J/m3",
  "critical_stretch": "dimensionless strain at which a bond lets go"
 },
 "sources": {
  "ICRP89": "ICRP Publication 89 (2002), Basic Anatomical and Physiological Data for Use in Radiological Protection: Reference Values. Adult male reference masses (Table 2.8) and regional blood volumes (Table 2.14, % of total blood volume, adult male).",
  "ICRP110": "ICRP Publication 110 (2009), Adult Reference Computational Phantoms: organ media and densities of the adult male phantom.",
  "ITIS41": "IT'IS Foundation Tissue Properties Database V4.1 (Hasgall et al., 2022): density, mean value.",
  "AIR": "Dry air at 20 degC and 101.325 kPa (standard atmosphere), 1.204 kg/m3, rounded.",
  "CREW_TISSUE": "src/crew_tissue.rs (branch claude/fea-damage-20261102, 2026-11-02): TEAR_J_M3 = [50000, 125000, 400000, 12500] J/m3 and CRITICAL_STRETCH = [0.6, 0.35, 0.05, 1.0] for skin, muscle, bone, fluid (0.4, 1.0, 3.2 and 0.1 J per 0.02 m cell). Authored game-level values in the owner's order, not measured tissue properties."
 },
 "transcription_note": "Reference values were transcribed offline from the cited publications as standard tabulated values; no network access was used in this session. Verify against the publications before citing them outside the project. No human-injury criteria or wound-ballistics thresholds are used anywhere in this table: the strength classes are the owner's authored game values.",
 "blood": {
  "reference_blood_volume_l": 5.3,
  "reference_blood_mass_kg": 5.6,
  "source": "ICRP89",
  "formula": "blood_volume_fraction = (ICRP 89 regional share of total blood) x 5.3 L / (reference tissue mass / density)",
  "unrepresented": "Large arteries (6%) and large veins (18%) are represented only by the explicit vessel_blood voxels; the rest of that 24% is not assigned to any label. Thyroid, lymph nodes, gonads, adrenals and 'all other tissues' (2.3% together) are not modelled.",
  "coupling_note": "The crew blood-volume system authors 6 L per man; ICRP 89's reference is 5.3 L. Scale by the ratio if the two must agree."
 },
 "strength_classes": {
  "skin": {
   "game_tissue": "Tissue::Skin",
   "tear_j_per_cell_0p02m": 0.4,
   "critical_stretch": 0.6,
   "tear_energy_density_j_m3": 50000,
   "note": "Existing crew_tissue class, unchanged. Also the class assigned (authored) to the soft, weak tissues that have no class of their own yet: fat, marrow, brain, spinal cord, eye, lung and the solid abdominal organs. The owner may author a separate parenchyma class later."
  },
  "muscle": {
   "game_tissue": "Tissue::Muscle",
   "tear_j_per_cell_0p02m": 1.0,
   "critical_stretch": 0.35,
   "tear_energy_density_j_m3": 125000,
   "note": "Existing crew_tissue class, unchanged. Also assigned (authored) to the heart wall, hollow muscular organs, oesophagus and cartilage."
  },
  "bone": {
   "game_tissue": "Tissue::Bone",
   "tear_j_per_cell_0p02m": 3.2,
   "critical_stretch": 0.05,
   "tear_energy_density_j_m3": 400000,
   "note": "Existing crew_tissue class, unchanged. Assigned to cortical bone and to spongiosa (trabecular bone with red marrow)."
  },
  "fluid": {
   "game_tissue": "fluid (crew_tissue's fourth class)",
   "tear_j_per_cell_0p02m": 0.1,
   "critical_stretch": 1.0,
   "tear_energy_density_j_m3": 12500,
   "note": "crew_tissue's own class (authored there): blood, CSF, urine and gut contents are held by a quarter of skin's tear energy, so they stay until struck and then spill; their flow belongs to the blood-volume system."
  },
  "gas": {
   "game_tissue": null,
   "tear_j_per_cell_0p02m": 0.0,
   "critical_stretch": null,
   "tear_energy_density_j_m3": 0,
   "note": "Authored for this table: air (airway lumen, exterior). Not a lattice cell; its mass is negligible."
  }
 },
